# .env.example — copy thành .env và điền giá trị thật
# cp .env.example .env

# ── Discord ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
BOT_USERNAME=Bé Yêu
BOT_AVATAR=

# ── Database (Neon free tier) ─────────────────────────────────────────────────
# Lấy connection string từ https://console.neon.tech/
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Cookie từ Chrome (tùy chọn — để relay dùng Gemini Web)
GEMINI_COOKIES=

# ── Relay (Chrome extension kết nối) ─────────────────────────────────────────
RELAY_ENABLED=true
RELAY_SECRET=your_relay_secret_here   # cùng giá trị với chrome extension

# ── Bot settings ──────────────────────────────────────────────────────────────
ADMIN_IDS=                            # Discord user IDs có quyền admin, cách nhau bằng dấu phẩy
ENABLE_TOOLS=true
MAX_HISTORY=50
REMOVE_GEMINI_WATERMARK=1
TRIGGER_KEYWORDS=gemini,ai,ask,hey bot

# ── Rate limiting (gemini-web-to-api) ────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000
