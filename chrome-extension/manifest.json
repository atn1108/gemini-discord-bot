{
  "manifest_version": 3,
  "name": "Gemini Discord Image Relay",
  "version": "1.0.0",
  "description": "Sinh và tải ảnh Gemini Web trực tiếp bằng Chrome profile thật, gửi bytes về Discord bot qua WebSocket.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://lh3.googleusercontent.com/*",
    "https://work.fife.usercontent.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gemini Image Relay"
  }
}
